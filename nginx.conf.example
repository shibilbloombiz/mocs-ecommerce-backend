# ==============================================================================
# Nginx Configuration for MOCS E-Commerce API + Multer Static Storage on VPS
# Location: /etc/nginx/sites-available/mocs-api
# Enable via: sudo ln -s /etc/nginx/sites-available/mocs-api /etc/nginx/sites-enabled/
# ==============================================================================

server {
    listen 80;
    server_name api.yourdomain.com; # Replace with your VPS domain or IP

    # Redirect HTTP to HTTPS (uncomment when SSL certificate is installed)
    # return 301 https://$host$request_uri;

    # Allow large image uploads (hero banners, product photos up to 25MB)
    client_max_body_size 25M;

    # 1. High-Performance Direct Image Serving for Multer Uploads
    location /uploads/ {
        alias /var/www/mocs-ecommerce-backend/src/uploads/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        add_header Access-Control-Allow-Origin "*";
        add_header Cross-Origin-Resource-Policy "cross-origin";
        access_log off;
        try_files $uri =404;
    }

    # 2. Reverse Proxy to Express Node.js Server
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Timeouts for heavy uploads
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
