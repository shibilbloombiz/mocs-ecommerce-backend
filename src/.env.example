# Mocs Backend Environment Configuration Template
PORT=5000
MONGO_URI=mongodb://localhost:27017/mocs
JWT_SECRET=supersecretmocskey123!
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:5175

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
